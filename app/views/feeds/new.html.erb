<h2>Add RSS Feed</h2>

<%= form_with model: @feed do |f| %>
  <div class="mb-3">
    <%= f.label :title %>
    <%= f.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :url %>
    <%= f.text_field :url, class: "form-control" %>
  </div>

  <%= f.submit "Save", class: "btn btn-success" %>
<% end %>
