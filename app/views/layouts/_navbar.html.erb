<nav class="navbar navbar-expand-lg border-bottom">
  <%= link_to "RSS Reader", root_path, class: "navbar-brand" %>

  <ul class="navbar-nav ms-auto">
    <% if user_signed_in? %>
      <li class="nav-item">
        <%= link_to "Logout", destroy_user_session_path,
                    data: { turbo_method: :delete },
                    class: "nav-link" %>
      </li>
    <% else %>
      <li class="nav-item">
        <%= link_to "Login", new_user_session_path, class: "nav-link" %>
      </li>
      <li class="nav-item">
        <%= link_to "Sign up", new_user_registration_path, class: "nav-link" %>
      </li>
    <% end %>
  </ul>
</nav>

<% if user_signed_in? %>
  <nav class="navbar navbar-expand-lg mb-4 border-bottom">
    <ul class="navbar-nav">
      <li class="nav-item">
        <%= link_to "All Feeds", feeds_path, class: "nav-link" %>
      </li>

      <% if @feeds.present? %>
        <% @feeds.each do |feed| %>
          <li class="nav-item">            
            <%= link_to feed, class: "nav-link" do %>
              <% if feed.image_url.present? %>
                <%= image_tag feed.image_url, width: "25" %>
              <% end %>
              
              <%= feed.title %>
            <% end %>
          </li>
        <% end %>
      <% end %>
    </ul>

    <%= link_to "Add Feed", new_feed_path, class: "btn btn-primary btn-sm ms-auto" %>
  </nav>
<% end %>
